<odoo>
    <record id="module_category_smart_inventory_count" model="ir.module.category">
        <field name="name">Smart Inventory Count</field>
        <field name="description">Controlled physical inventory counting</field>
        <field name="sequence">35</field>
    </record>
    <record id="privilege_smart_inventory_count" model="res.groups.privilege">
        <field name="name">Smart Inventory Count</field>
        <field name="description">Permissions for controlled physical inventory counting</field>
        <field name="category_id" ref="module_category_smart_inventory_count"/>
        <field name="sequence">35</field>
    </record>
    <record id="group_count_user" model="res.groups">
        <field name="name">Smart Count User</field>
        <field name="comment">Can work on assigned count sheets, scan or select products, enter counted quantities, and submit the sheet. Cannot create sessions, consolidate results, approve variances, or close a count.</field>
        <field name="privilege_id" ref="privilege_smart_inventory_count"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_count_manager" model="res.groups">
        <field name="name">Smart Count Supervisor</field>
        <field name="comment">Can create and configure count sessions, assign users and locations, consolidate submitted sheets, review variances, approve adjustments, and close the count.</field>
        <field name="privilege_id" ref="privilege_smart_inventory_count"/>
        <field name="implied_ids" eval="[(4, ref('group_count_user')), (4, ref('stock.group_stock_manager'))]"/>
    </record>
</odoo>
