<odoo>
    <record id="view_count_session_tree" model="ir.ui.view"><field name="name">ff.inventory.count.session.tree</field><field name="model">ff.inventory.count.session</field><field name="arch" type="xml"><list><field name="name"/><field name="scheduled_date"/><field name="warehouse_id"/><field name="state"/><field name="company_id"/></list></field></record>
    <record id="view_count_session_form" model="ir.ui.view"><field name="name">ff.inventory.count.session.form</field><field name="model">ff.inventory.count.session</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start Count" class="btn-primary" invisible="state != 'draft'"/><button name="action_consolidate" type="object" string="Consolidate" class="btn-primary" invisible="state not in ('in_progress','submitted')" groups="ff_smart_inventory_count.group_count_manager"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'under_review'" groups="ff_smart_inventory_count.group_count_manager"/><button name="action_apply_remaining_adjustments" type="object" string="Apply Adjustments" class="btn-primary" invisible="state not in ('approved','done') or not has_remaining_adjustments" groups="ff_smart_inventory_count.group_count_manager"/><button name="action_close" type="object" string="Close" invisible="state != 'approved'" groups="ff_smart_inventory_count.group_count_manager"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('approved','done','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,in_progress,under_review,approved,done"/></header><sheet><group><field name="has_remaining_adjustments" invisible="1"/><field name="name"/><field name="company_id" readonly="state != 'draft'"/><field name="warehouse_id" readonly="state != 'draft'"/><field name="count_scope" readonly="state != 'draft'"/><field name="location_ids" widget="many2many_tags" domain="[('usage', '=', 'internal'), ('company_id', 'in', [False, company_id])]" invisible="count_scope == 'warehouse'" readonly="state != 'draft'" help="Choose the internal locations included in this count."/><field name="assigned_user_ids" widget="many2many_tags" readonly="state != 'draft'" help="With one user, the module creates one sheet per selected location automatically."/><field name="scheduled_date" readonly="state != 'draft'"/><field name="assignment_ids" readonly="state != 'draft'"><list editable="bottom"><field name="location_id"/><field name="assigned_user_id"/></list></field><field name="supervisor_ids" widget="many2many_tags" readonly="state != 'draft'"/><field name="movement_policy" readonly="state != 'draft'"/><field name="notes"/></group><notebook><page string="Sheets"><field name="sheet_ids"><list editable="bottom"><field name="name"/><field name="location_id"/><field name="assigned_user_id"/><field name="state"/><field name="counted_product_count"/></list></field></page><page string="Consolidated Results"><field name="consolidated_line_ids" domain="[('variance_qty', '!=', 0)]"><list editable="bottom"><field name="product_id" readonly="1"/><field name="location_id" readonly="1"/><field name="theoretical_qty" readonly="1"/><field name="counted_qty" readonly="1"/><field name="variance_qty" readonly="1"/><field name="variance_value" readonly="1"/><field name="reconciliation_status"/><field name="variance_reason"/></list></field></page></notebook></sheet></form></field></record>
    <record id="view_count_sheet_tree" model="ir.ui.view"><field name="name">ff.inventory.count.sheet.tree</field><field name="model">ff.inventory.count.sheet</field><field name="arch" type="xml"><list create="false"><field name="name"/><field name="session_id"/><field name="location_id"/><field name="assigned_user_id"/><field name="state"/><field name="counted_product_count"/></list></field></record>
    <record id="view_count_sheet_form" model="ir.ui.view"><field name="name">ff.inventory.count.sheet.form</field><field name="model">ff.inventory.count.sheet</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/><button name="action_open_line_import" type="object" string="Import Lines" invisible="state != 'in_progress'"/><button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'in_progress'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="session_id" readonly="1"/><field name="location_id" readonly="1"/><field name="assigned_user_id" readonly="1"/></group><field name="name" invisible="1"/><field name="line_ids"><list editable="bottom" class="o_ff_inventory_count_lines"><field name="product_id" string="Product" placeholder="Scan barcode or type product"/><field name="on_hand_qty" string="On Hand"/><field name="counted_qty" string="Counted Qty"/></list></field></sheet></form></field></record>
    <record id="view_count_line_import_tree" model="ir.ui.view"><field name="name">ff.inventory.count.line.import.tree</field><field name="model">ff.inventory.count.line</field><field name="arch" type="xml"><list editable="bottom" import="1"><field name="barcode_reference" string="Barcode"/><field name="product_id" string="Product"/><field name="product_default_code" string="Internal Reference" readonly="1"/><field name="product_barcode" string="Product Barcode" readonly="1"/><field name="on_hand_qty" string="On Hand" readonly="1"/><field name="counted_qty" string="Counted Qty"/><field name="sheet_id" column_invisible="1"/></list></field></record>
    <record id="view_count_session_search" model="ir.ui.view"><field name="name">ff.inventory.count.session.search</field><field name="model">ff.inventory.count.session</field><field name="arch" type="xml"><search><field name="name"/><field name="warehouse_id"/><field name="assigned_user_ids"/><field name="scheduled_date"/><filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/><filter name="counting" string="Counting" domain="[('state', '=', 'in_progress')]"/><filter name="review" string="Under Review" domain="[('state', '=', 'under_review')]"/><filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/><group><filter name="group_state" string="State" context="{'group_by': 'state'}"/><filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/><filter name="group_date" string="Scheduled Date" context="{'group_by': 'scheduled_date'}"/></group></search></field></record>
    <record id="view_count_sheet_search" model="ir.ui.view"><field name="name">ff.inventory.count.sheet.search</field><field name="model">ff.inventory.count.sheet</field><field name="arch" type="xml"><search><field name="name"/><field name="session_id"/><field name="location_id"/><field name="assigned_user_id"/><filter name="my_sheets" string="My Sheets" domain="[('assigned_user_id', '=', uid)]"/><filter name="counting" string="Counting" domain="[('state', '=', 'in_progress')]"/><filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/><group><filter name="group_state" string="State" context="{'group_by': 'state'}"/><filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/><filter name="group_assignee" string="Assigned User" context="{'group_by': 'assigned_user_id'}"/></group></search></field></record>
    <record id="action_count_sessions" model="ir.actions.act_window"><field name="name">Count Sessions</field><field name="res_model">ff.inventory.count.session</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_count_session_search"/></record>
    <record id="action_count_sheets" model="ir.actions.act_window"><field name="name">My Count Sheets</field><field name="res_model">ff.inventory.count.sheet</field><field name="view_mode">list,form</field><field name="domain">[('assigned_user_id', '=', uid)]</field><field name="search_view_id" ref="view_count_sheet_search"/></record>
    <record id="view_count_session_form_opening_type" model="ir.ui.view">
        <field name="name">ff.inventory.count.session.form.opening.type</field>
        <field name="model">ff.inventory.count.session</field>
        <field name="inherit_id" ref="ff_smart_inventory_count.view_count_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='count_scope']" position="before">
                <field name="count_type"/>
            </xpath>
            <xpath expr="//field[@name='count_scope']" position="after">
                <field name="default_variance_reason" invisible="count_type == 'opening'" help="Used only for regular inventory counts; opening inventory always posts variances to the opening inventory account."/>
            </xpath>
        </field>
    </record>
</odoo>
