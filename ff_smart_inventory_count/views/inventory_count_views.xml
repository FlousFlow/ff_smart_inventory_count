<odoo>
    <record id="view_count_session_tree" model="ir.ui.view"><field name="name">ff.inventory.count.session.tree</field><field name="model">ff.inventory.count.session</field><field name="arch" type="xml"><list><field name="name"/><field name="scheduled_date"/><field name="warehouse_id"/><field name="state"/><field name="company_id"/></list></field></record>
    <record id="view_count_session_form" model="ir.ui.view"><field name="name">ff.inventory.count.session.form</field><field name="model">ff.inventory.count.session</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start Count" class="btn-primary" invisible="state != 'draft'"/><button name="action_consolidate" type="object" string="Consolidate" class="btn-primary" invisible="state not in ('in_progress','submitted')" groups="ff_smart_inventory_count.group_count_manager"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'under_review'" groups="ff_smart_inventory_count.group_count_manager"/><button name="action_apply_remaining_adjustments" type="object" string="Apply Adjustments" class="btn-primary" invisible="state not in ('approved','done') or not has_remaining_adjustments" groups="ff_smart_inventory_count.group_count_manager"/><button name="action_close" type="object" string="Close" invisible="state != 'approved'" groups="ff_smart_inventory_count.group_count_manager"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('approved','done','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,in_progress,under_review,approved,done"/></header><sheet><group><field name="has_remaining_adjustments" invisible="1"/><field name="name"/><field name="company_id"/><field name="warehouse_id"/><field name="location_ids" invisible="1"/><field name="scheduled_date"/><field name="assignment_ids"><list editable="bottom"><field name="location_id"/><field name="assigned_user_id"/></list></field><field name="supervisor_ids" widget="many2many_tags"/><field name="movement_policy"/><field name="notes"/></group><notebook><page string="Sheets"><field name="sheet_ids"><list editable="bottom"><field name="name"/><field name="location_id"/><field name="assigned_user_id"/><field name="state"/><field name="counted_product_count"/></list></field></page><page string="Consolidated Results"><field name="consolidated_line_ids" domain="[('variance_qty', '!=', 0)]"><list editable="bottom"><field name="product_id"/><field name="location_id"/><field name="theoretical_qty"/><field name="counted_qty"/><field name="variance_qty"/><field name="variance_value"/><field name="reconciliation_status"/><field name="variance_reason"/></list></field></page></notebook></sheet></form></field></record>
    <record id="view_count_sheet_tree" model="ir.ui.view"><field name="name">ff.inventory.count.sheet.tree</field><field name="model">ff.inventory.count.sheet</field><field name="arch" type="xml"><list create="false"><field name="name"/><field name="session_id"/><field name="location_id"/><field name="assigned_user_id"/><field name="state"/><field name="counted_product_count"/></list></field></record>
    <record id="view_count_sheet_form" model="ir.ui.view"><field name="name">ff.inventory.count.sheet.form</field><field name="model">ff.inventory.count.sheet</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/><button name="action_open_line_import" type="object" string="Import Lines" invisible="state != 'in_progress'"/><button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'in_progress'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="session_id" readonly="1"/><field name="location_id" readonly="1"/><field name="assigned_user_id" readonly="1"/></group><field name="name" invisible="1"/><field name="line_ids"><list editable="bottom" class="o_ff_inventory_count_lines"><field name="product_id" string="Product" placeholder="Scan barcode or type product"/><field name="on_hand_qty" string="On Hand"/><field name="counted_qty" string="Counted Qty"/></list></field></sheet></form></field></record>
    <record id="view_count_line_import_tree" model="ir.ui.view"><field name="name">ff.inventory.count.line.import.tree</field><field name="model">ff.inventory.count.line</field><field name="arch" type="xml"><list editable="bottom" import="1"><field name="product_id" string="Product"/><field name="counted_qty" string="Counted Qty"/><field name="sheet_id" column_invisible="1"/></list></field></record>
    <record id="action_count_sessions" model="ir.actions.act_window"><field name="name">Count Sessions</field><field name="res_model">ff.inventory.count.session</field><field name="view_mode">list,form</field></record>
    <record id="action_count_sheets" model="ir.actions.act_window"><field name="name">My Count Sheets</field><field name="res_model">ff.inventory.count.sheet</field><field name="view_mode">list,form</field><field name="domain">[('assigned_user_id', '=', uid)]</field></record>
</odoo>
