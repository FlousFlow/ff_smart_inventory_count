#. module: ff_smart_inventory_count
#: model:res.groups,comment:ff_smart_inventory_count.group_count_user
msgid "Can work on assigned count sheets, scan or select products, enter counted quantities, and submit the sheet. Cannot create sessions, consolidate results, approve variances, or close a count."
msgstr "يمكنه العمل على أوراق الجرد المعيّنة له، واختيار المنتجات أو مسح الباركود، وإدخال الكميات المعدودة وتسليم الورقة. لا يمكنه إنشاء الجلسات أو تجميع النتائج أو اعتماد الفروقات أو إغلاق الجرد."

#. module: ff_smart_inventory_count
#: model:res.groups,comment:ff_smart_inventory_count.group_count_manager
msgid "Can create and configure count sessions, assign users and locations, consolidate submitted sheets, review variances, approve adjustments, and close the count."
msgstr "يمكنه إنشاء وتجهيز جلسات الجرد، وتعيين المستخدمين واللوكيشنات، وتجميع الأوراق المسلّمة، ومراجعة الفروقات، واعتماد التسويات وإغلاق الجرد."

#. module: ff_smart_inventory_count
#: code:models/inventory_count.py:163
msgid "A count session with activity or counted quantities cannot be deleted. Cancel it instead."
msgstr "لا يمكن حذف جلسة جرد بها حركة أو كميات معدودة. استخدم الإلغاء بدلًا من الحذف."

#. module: ff_smart_inventory_count
#: code:models/inventory_count.py:229
msgid "A count sheet with activity or counted quantities cannot be deleted."
msgstr "لا يمكن حذف ورقة جرد بها حركة أو كميات معدودة."

#. module: ff_smart_inventory_count
#: code:models/inventory_count.py:330
msgid "Counted lines cannot be deleted after counting has started."
msgstr "لا يمكن حذف بنود الجرد بعد بدء عملية العد."

#. module: ff_smart_inventory_count
#: code:models/inventory_count.py:388
msgid "Approved inventory results cannot be deleted."
msgstr "لا يمكن حذف نتائج الجرد المعتمدة."

